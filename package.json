{
  "name": "living-community-brief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "module:start": "node --env-file=server/chat-hackers/.env --import tsx server/chat-hackers/index.ts",
    "module:dev": "npm run module:typecheck && npm run module:start",
    "module:register": "node --env-file=server/chat-hackers/.env --import tsx server/chat-hackers/register.ts",
    "module:typecheck": "tsc --noEmit -p server/chat-hackers/tsconfig.json"
  },
  "dependencies": {
    "matrix-js-sdk": "44.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
