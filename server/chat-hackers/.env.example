CH_MATRIX_SERVER=https://matrix.example.org
CH_MATRIX_TOKEN=replace-with-dedicated-service-account-token
CH_SOURCE_ROOM_ID=!source-room
CH_STORAGE_ROOM_ID=!different-storage-room
# Exact bridged Matrix IDs, not display names or WhatsApp phone numbers.
CH_CONFIRMERS=@organiser:example.org
CH_MODULE_URL=https://your-tunnel.example.org/
# Optional: only needed if using the Hub /api/send API (not used by this module).
CH_TOOL_SECRET=
CH_DATA_DIR=.chat-hackers-data
CH_PORT=5050
# false: any calendar reaction in the configured group saves a valid activity.
CH_REQUIRE_CONFIRMATION=false
# Hub mode needs no source-room access for the service account. The organiser
# must send X-Community-Brief-Secret with the same random 64-hex-character value.
CH_EVENT_SOURCE=hub
CH_WEBHOOK_SECRET=replace-with-64-random-hex-characters
# Explicit demo opt-in only. Allows forged callbacks; no Hub header required.
CH_ALLOW_UNAUTHENTICATED_HUB=false
